#@@ code
%%local
try:
    import matplotlib
    import matplotlib.pyplot as plt
    q1 = q1_sdf.sort_values("bucket")
    fig, ax = plt.subplots(figsize=(7.5, 4))
    ax.bar(q1["bucket"], q1["mean_abs_ret"] * 100, color="#4C78A8", label="mean |daily return|")
    ax.plot(q1["bucket"], q1["median_abs_ret"] * 100, "o-", color="#F58518", label="median")
    for i, n in enumerate(q1["n"]):
        ax.annotate(f"n={int(n):,}", (i, 0.02), ha="center", va="bottom", fontsize=8, color="white")
    ax.set_ylabel("absolute same-day return (%)")
    ax.set_title("Figure 1 (Q1): unusual volume (z vs own prior 60 bars) and absolute price moves")
    ax.legend(); plt.xticks(rotation=12); plt.tight_layout(); plt.show()
except Exception as ex:
    print("Plot skipped (the table above is the evidence):", ex)

#@@ code
%%local
try:
    import matplotlib.pyplot as plt
    q2 = q2_week_sdf
    if len(q2) < 9:
        print(f"Figure 2 skipped: only {len(q2)} usable weeks (need >= 9 to interpret).")
    else:
        fig, axes = plt.subplots(1, 2, figsize=(11, 4))
        axes[0].scatter(q2["news_events"] / 1e6, q2["mean_next_vol"] * 100, c="#4C78A8")
        axes[0].set_xlabel("GDELT events added in the 7 days before the anchor (millions)")
        axes[0].set_ylabel("mean next-week volatility (%)")
        axes[0].set_title(f"Figure 2a (Q2): one point per week (n={len(q2)})")
        g = q2.groupby("news_group").agg(weeks=("anchor_date", "count"), vol=("mean_next_vol", "mean"), ret=("mean_ret_next", "mean")).reset_index()
        axes[1].bar(g["news_group"] + "\n(" + g["weeks"].astype(str) + " weeks)", g["vol"] * 100, color="#72B7B2")
        axes[1].set_ylabel("mean next-week volatility (%)")
        axes[1].set_title("Figure 2b (Q2): by news-volume tercile (T1 low .. T3 high)")
        plt.tight_layout(); plt.show()
except Exception as ex:
    print("Plot skipped (the table above is the evidence):", ex)

#@@ code
%%local
try:
    import matplotlib.pyplot as plt
    fig, axes = plt.subplots(2, 3, figsize=(15, 7.5))
    for r, task in enumerate(["direction", "high_vol"]):
        for c, dim in enumerate(["vol_group", "quarter"]):
            d = q3_sdf[(q3_sdf["task"] == task) & (q3_sdf["dim"] == dim)].sort_values("grp")
            ax, x = axes[r][c], range(len(d))
            ax.bar([i - 0.27 for i in x], d["model_acc"], 0.27, label="model", color="#4C78A8")
            ax.bar([i for i in x], d["majority_acc"], 0.27, label="majority", color="#BAB0AC")
            ax.bar([i + 0.27 for i in x], d["rule_acc"], 0.27, label="simple rule", color="#F58518")
            ax.set_xticks(list(x)); ax.set_xticklabels([f"{g}\nn={int(n):,}" for g, n in zip(d["grp"], d["n"])], fontsize=7)
            ax.set_ylim(0.3, 1.0); ax.set_title(f"Figure 3 (Q3) {task}: test accuracy by {dim}", fontsize=9); ax.legend(fontsize=7)
        m = cm_sdf[cm_sdf["task"] == task].pivot_table(index="label", columns="prediction", values="count", fill_value=0)
        axes[r][2].imshow(m.values, cmap="Blues")
        for i in range(m.shape[0]):
            for j in range(m.shape[1]):
                axes[r][2].text(j, i, f"{int(m.values[i, j]):,}", ha="center", va="center")
        axes[r][2].set_xticks(range(m.shape[1])); axes[r][2].set_xticklabels([f"pred {int(v)}" for v in m.columns])
        axes[r][2].set_yticks(range(m.shape[0])); axes[r][2].set_yticklabels([f"actual {int(v)}" for v in m.index])
        axes[r][2].set_title(f"Figure 3 (Q3) {task}: test confusion matrix", fontsize=9)
    plt.tight_layout(); plt.show()
except Exception as ex:
    print("Plot skipped (the table above is the evidence):", ex)

#@@ md
### How to read the results (limitations, uncertainty, no causal claims)

* **Q1** shows that days with unusually high volume (relative to the same ticker's own recent history) coincide with larger absolute price moves. This is contemporaneous association; it is not evidence that volume *causes* moves.
* **Q2** is interpretable only if the acquired GDELT window gives enough weeks (guard above). The news signal is market-wide, so the effective sample is the number of weeks; alternative explanations (market-wide events, seasonality, the GDELT upward trend in volume) are not controlled.
* **Q3** shows where each model is reliable. A model that merely predicts the majority class matches the majority baseline everywhere — compare `model_acc`, `majority_acc`, `rule_acc` and `recall_positive`, not accuracy alone. Nothing is retuned on test results.
* Reported numbers are **source-price-ratio / model diagnostics**, not economic returns, and are not proof of historical investability.
