#@@ md
## 0. Setup

### 0.1 Parameters (the only cell you may need to edit)

* `VERSION` — the raw-data version folder staged in HDFS (`/raw/prices/<VERSION>`). Must match what you gave Stage 1 and Stage 2.
* `BUCKET` — your S3 bucket (outputs and models are saved there so they survive cluster termination).
* `ACTIVE_CONFIG` — `"reference"` or `"alternative"` (the justified software alternative, Section 5). Everything else stays the same.

#@@ code
import json, time, datetime, math, statistics, os, socket, sys, itertools
from pyspark.sql import functions as F, Window
from pyspark.sql.types import StringType

# ------------------------------------------------------------------ parameters
VERSION       = "v2026-10-29-q1-2016"            # raw-data version (docs/input_profiles.md); Q1-2016 profile: "v2026-10-29-q1-2016"
BUCKET        = "inf2006-team07-bigdata-1-310947418945-us-east-1-an"
ACTIVE_CONFIG = "reference"              # "reference" | "alternative"
REPETITIONS   = 3                        # brief: median of three repetitions

# ------------------------------------------------------------------ fixed project settings
SEED          = 42
TRAIN_END, VAL_START, VAL_END, TEST_START = "2015-12-31", "2016-01-01", "2016-12-31", "2017-01-01"
DATA_END      = "2017-12-29"             # last day of the assessed price scope
MIN_HISTORY   = 61                       # bars of history before the first usable weekly anchor
HIGH_VOL_Q    = 0.67                     # "high-volatility week" = top third of TRAIN next-week volatility
TOL           = 1e-9                     # numerical tolerance for the saved-model reload check
CONFIGS = {                              # software-only comparison (hardware, release, replication fixed)
    "reference":   {"shuffle_partitions": 200, "aqe": False,
                    "why": "Spark default shuffle partitions; fixed 2 executors x 2 cores x 6 GiB"},
    "alternative": {"shuffle_partitions": 8,   "aqe": True,
                    "why": "8 partitions ~ 2x total cores for a ~30 MB shuffle; adaptive execution coalesces small partitions"},
}

IS_EMR = "amzn" in spark.version
sc = spark.sparkContext
spark.conf.set("spark.sql.shuffle.partitions", str(CONFIGS[ACTIVE_CONFIG]["shuffle_partitions"]))
spark.conf.set("spark.sql.adaptive.enabled", str(CONFIGS[ACTIVE_CONFIG]["aqe"]).lower())

if IS_EMR:
    PREP        = f"hdfs:///prepared/{VERSION}/{ACTIVE_CONFIG}"
    MODELS_HDFS = f"hdfs:///models/{VERSION}"
    OUT_CANDIDATES = [f"s3://{BUCKET}/notebook_outputs/{VERSION}", f"hdfs:///project/notebook_outputs/{VERSION}"]
else:                                    # local development only (never counts as the assessed run)
    LOCAL_ROOT  = os.path.abspath("work/nb")
    PREP        = f"file://{LOCAL_ROOT}/prepared/{VERSION}/{ACTIVE_CONFIG}"
    MODELS_HDFS = f"file://{LOCAL_ROOT}/models/{VERSION}"
    OUT_CANDIDATES = [f"file://{LOCAL_ROOT}/out/{VERSION}"]
    LOCAL_PRICES = "data/raw/prices/all_stocks_5yr.csv"
    LOCAL_GDELT_AUDIT = {"v2026-10-27": "evidence/local/streaming_gdelt_audit.tsv",
                         "v2026-10-29-q1-2016": "evidence/local/q1_2016/streaming_gdelt_audit.tsv"}.get(
                             VERSION, "evidence/local/streaming_gdelt_audit.tsv")

#@@ md
### 0.2 Helper functions (stage timer, file writer, checks)

* `stage(...)` times each pipeline stage (wall clock) and records it for Section 5.
* `write_text` / `read_text` write small evidence files to S3 / HDFS through Hadoop's file API (no extra libraries).
* `check(...)` records one verification line: check, expected, actual, pass/fail.

#@@ code
def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")

# ---- output location: S3 if writable (survives cluster termination), else HDFS
def write_text(path, text):
    jvm, conf = spark._jvm, spark._jsc.hadoopConfiguration()
    p = jvm.org.apache.hadoop.fs.Path(path)
    out = p.getFileSystem(conf).create(p, True)
    out.write(bytearray(text.encode("utf-8")))
    out.close()

def read_text(path):
    return "\n".join(r[0] for r in spark.read.text(path).collect())

OUT = None
for cand in OUT_CANDIDATES:
    try:
        write_text(f"{cand}/_write_test.txt", utc_now())
        OUT = cand
        break
    except Exception as ex:
        print(f"WARNING: cannot write to {cand}: {str(ex)[:120]}")
assert OUT, "No writable output location. Check the S3 bucket name / EMR role permissions (docs/RUN_ON_EMR.md, Troubleshooting)."
MODELS_OUT = f"{OUT}/models"
EV = f"{OUT}/evidence/{ACTIVE_CONFIG}"
print("outputs  :", OUT)
print("prepared :", PREP)
print("models   :", MODELS_HDFS, "and", MODELS_OUT)

def save_json(name, obj):
    write_text(f"{EV}/{name}", json.dumps(obj, indent=2, default=str))

# ---- stage timer
CURRENT_LOG = []
class stage:
    def __init__(self, name, **meta):
        self.name, self.meta = name, dict(meta)
    def __enter__(self):
        self.t0, self.start = time.time(), utc_now()
        return self
    def __exit__(self, exc_type, exc, tb):
        rec = {"stage": self.name, "start_utc": self.start, "end_utc": utc_now(),
               "seconds": round(time.time() - self.t0, 2), "ok": exc_type is None, **self.meta}
        CURRENT_LOG.append(rec)
        print(f"[stage] {self.name}: {rec['seconds']} s" + ("" if rec["ok"] else "  FAILED"))
        return False

# ---- verification record
CHECKS = []
def check(name, expected, actual, ok=None, evidence=""):
    ok = (expected == actual) if ok is None else bool(ok)
    CHECKS.append({"check": name, "expected": str(expected), "actual": str(actual), "passed": ok, "evidence": evidence})
    print(("PASS  " if ok else "FAIL  ") + f"{name}: expected={expected} actual={actual}")
    return ok

def show(df, n=20):
    df.show(n, truncate=False)

